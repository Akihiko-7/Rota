# Copy to .env and fill in. Never commit .env.

# --- NEAR ---
# NEAR_RPC_URL may list several endpoints, comma-separated (failover)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com,https://test.rpc.fastnear.com
# Deploy account (created by scripts/create-testnet-account.ts on testnet)
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# Circle contract account; locked (no keys) after deployment
ROTA_CONTRACT_ID=
# Mock NEP-141 on testnet; on mainnet USDC is 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
ROTA_TOKEN_ID=

# --- AI treasurer ---
# Treasurer account and its function-call key (receiver = ROTA_CONTRACT_ID, methods = ["settle"])
TREASURER_ACCOUNT_ID=
TREASURER_FC_PRIVATE_KEY=

# --- NEAR AI Cloud ---
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- NEAR Intents 1Click (optional; without it a 0.2% fee applies) ---
ONECLICK_JWT=

# --- Bot runtime (optional) ---
# NEARAI_MODEL above defaults to Qwen/Qwen3.8-27B
SETTLE_INTERVAL_SEC=15
# BOT_STATE_PATH=bot/data/state.json
# BOT_TRANSCRIPT_PATH=bot/data/transcript.jsonl   (logs messages the bot receives/sends; off by default)

# Rota web app URL, for the bot's /link signing page
WEB_URL=
