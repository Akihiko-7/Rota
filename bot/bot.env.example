# Everything the bot reads. Copy to bot/bot.env (gitignored) for Docker.
# Do not put the deployer's or any member's key here: the bot ignores every
# *PRIVATE_KEY variable except TREASURER_FC_PRIVATE_KEY, and refuses to start
# unless that key is a function-call key limited to `settle` on the circle.

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com,https://test.rpc.fastnear.com
ROTA_CONTRACT_ID=circle-v2.rota-nearhack.testnet
ROTA_TOKEN_ID=usdc-mock.rota-nearhack.testnet
TREASURER_ACCOUNT_ID=treasurer-v2.rota-nearhack.testnet
TREASURER_FC_PRIVATE_KEY=

TELEGRAM_BOT_TOKEN=

# NEAR AI Cloud (no other LLM provider is used)
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3.8-27B

# Optional
SETTLE_INTERVAL_SEC=15
# BOT_STATE_PATH=/data/state.json        (set by the Dockerfile)
# BOT_TRANSCRIPT_PATH=/data/transcript.jsonl   (logs what the bot sees and sends; off by default)

# Rota web app URL, for the /link signing page
WEB_URL=https://rota-alpha-seven.vercel.app
